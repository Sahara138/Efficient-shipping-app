<div class="wishlist-container">
  <button
    type="button"
    class="wishlist-button"
    data-product-id="{{ block.settings.product.id }}"
    aria-label="Add to wishlist"
  >
    <span class="wishlist-icon">
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M20.84 4.61C19.81 3.58 18.43 3 17 3C15.57 3 14.19 3.58 13.16 4.61L12 5.77L10.84 4.61C8.79 2.56 5.47 2.56 3.42 4.61C1.37 6.66 1.37 9.98 3.42 12.03L12 20.61L20.58 12.03C22.63 9.98 22.63 6.66 20.84 4.61Z"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </span>

    <span class="wishlist-label">
      <span class="wishlist-small">Add to</span>
      <span class="wishlist-main">Wishlist</span>
    </span>
  </button>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const buttons = document.querySelectorAll(".wishlist-button");

    buttons.forEach(function (button) {
      const productId = button.dataset.productId;

      let wishlist = JSON.parse(
        localStorage.getItem("shopify_wishlist") || "[]"
      );

      if (wishlist.includes(productId)) {
        button.classList.add("active");
      }

      button.addEventListener("click", function () {
        let wishlist = JSON.parse(
          localStorage.getItem("shopify_wishlist") || "[]"
        );

        if (wishlist.includes(productId)) {
          wishlist = wishlist.filter(function (id) {
            return id !== productId;
          });

          button.classList.remove("active");
        } else {
          wishlist.push(productId);
          button.classList.add("active");
        }

        localStorage.setItem(
          "shopify_wishlist",
          JSON.stringify(wishlist)
        );
      });
    });
  });
</script>

<style>
  .wishlist-container {
    display: inline-flex;
    margin: 8px 0;
  }

  .wishlist-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    min-height: 42px;
    padding: 6px 13px 6px 9px;

    border: 1px solid #e5e5e5;
    border-radius: 22px;

    background: #ffffff;
    color: #222222;

    cursor: pointer;

    transition:
      border-color 0.25s ease,
      background 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.2s ease;
  }

  .wishlist-icon {
    width: 29px;
    height: 29px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #f7f7f7;
    color: #222222;

    transition:
      background 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease;
  }

  .wishlist-label {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;

    line-height: 1.05;
  }

  .wishlist-small {
    font-size: 9px;
    font-weight: 400;
    color: #777777;
    letter-spacing: 0.1px;
  }

  .wishlist-main {
    margin-top: 2px;

    font-size: 11px;
    font-weight: 600;

    color: #222222;
    letter-spacing: 0.2px;
  }

  /* Hover */
  .wishlist-button:hover {
    border-color: #222222;
    background: #fafafa;

    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.07);
    transform: translateY(-1px);
  }

  .wishlist-button:hover .wishlist-icon {
    transform: scale(1.08);
    background: #222222;
    color: #ffffff;
  }

  /* Active */
  .wishlist-button.active {
    border-color: #222222;
    background: #222222;
    color: #ffffff;
  }

  .wishlist-button.active .wishlist-icon {
    background: #ffffff;
    color: #e53935;
  }

  .wishlist-button.active .wishlist-small,
  .wishlist-button.active .wishlist-main {
    color: #ffffff;
  }

  /* Mobile */
  @media screen and (max-width: 480px) {
    .wishlist-button {
      min-height: 40px;
      padding-right: 11px;
    }

    .wishlist-icon {
      width: 27px;
      height: 27px;
    }

    .wishlist-main {
      font-size: 10px;
    }
  }
</style>

{% schema %}
{
  "name": "Wishlist",
  "target": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "autofill": true
    }
  ]
}
{% endschema %}